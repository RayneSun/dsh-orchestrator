{
  "name": "@may/dsh-orchestrator",
  "version": "0.3.11",
  "description": "DSH 主控助理编排插件：Lead 通过持久子会话和 TaskRun 分发后台任务",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./package.json": "./package.json",
    "./dsh-computer-use-darwin": "./lib/vendor/dsh-computer-use-darwin/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "rm -rf lib && tsdown && node scripts/copy-vendor.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "pack:dry": "npm pack --dry-run",
    "pack:dist": "pnpm build && pnpm verify:packaging && node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && npm pack --pack-destination dist",
    "link:dsh": "node scripts/link-dsh.mjs",
    "verify:packaging": "node scripts/verify-packaging.mjs"
  },
  "dependencies": {
    "@milkuovo/dsh-computer-use": "0.3.1",
    "@wxg-prc-cpg/browser-skill-dsh-plugin": "0.3.2",
    "@zhengjunyao/dsh-qqmail": "0.1.1",
    "meow-memory": "0.31.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "react",
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "plugin",
    "orchestrator",
    "subagent",
    "task-runner"
  ]
}
